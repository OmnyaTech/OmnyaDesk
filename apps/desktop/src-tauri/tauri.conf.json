{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmnyaDesk",
  "version": "0.1.0",
  "identifier": "tech.omnya.desk",
  "build": {
    "frontendDist": "../../../dist/apps/desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OmnyaDesk",
        "width": 1320,
        "height": 860,
        "minWidth": 750,
        "minHeight": 550,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ]
  }
}